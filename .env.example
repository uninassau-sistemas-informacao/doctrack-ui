# Minutos de inatividade antes do logout automático no cliente (E9.4 / RNF01.5). A API tem seu
# próprio backstop no refresh (app.session.idle-timeout-minutes, no doctrack-api).
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30

# Origem do storage de anexos (connect-src da CSP). Em produção: https://doctrack-storage.guizimmermann.dev
STORAGE_URL=http://localhost:9000
